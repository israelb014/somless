rules_version = '2';

// ============================================================================
// SomLess — Firestore Security Rules
//
// עיקרון: כל הנתונים חיים תחת families/{familyId}. גישה ניתנת אך ורק
// למשתמש מאומת (Google Sign-In) שכתובת המייל שלו נמצאת ברשימת ה-members
// של מסמך המשפחה. ה-whitelist מתוחזק במסמך families/{familyId}.members
// (מערך של מיילים באותיות קטנות) ונכתב רק מהאדמין / סקריפט ה-seed.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // --- עזרים -------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    // המייל של המשתמש המחובר, באותיות קטנות ("" אם אין)
    function authEmail() {
      return isSignedIn() ? request.auth.token.get('email', '').lower() : '';
    }

    function familyDoc(familyId) {
      return get(/databases/$(database)/documents/families/$(familyId)).data;
    }

    // חבר משפחה = מאומת + מייל מאומת + נמצא ברשימת ה-members של המשפחה
    function isFamilyMember(familyId) {
      return isSignedIn()
        && request.auth.token.get('email_verified', false) == true
        && authEmail() != ''
        && exists(/databases/$(database)/documents/families/$(familyId))
        && authEmail() in familyDoc(familyId).members;
    }

    function isValidStatus(status) {
      return status in ['contains', 'may_contain', 'safe'];
    }

    // ולידציה של מסמך מוצר. allergens הוא מפה: { <allergenId>: <status> }
    function isValidProduct() {
      return request.resource.data.keys().hasOnly([
               'name', 'nameNormalized', 'brand', 'allergens', 'note', 'source',
               'createdAt', 'createdBy', 'updatedAt', 'updatedBy'
             ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.brand is string
        && request.resource.data.brand.size() <= 80
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 500
        && request.resource.data.allergens is map
        && request.resource.data.allergens.size() > 0
        && request.resource.data.allergens.values().hasOnly(['contains', 'may_contain', 'safe'])
        && request.resource.data.updatedBy is string;
    }

    // --- משפחות ------------------------------------------------------------
    // קריאה: לחברי המשפחה בלבד. כתיבה: חסומה ללקוח (ניהול ידני / firebase-admin),
    // כדי שאף משתמש לא יוכל להוסיף את עצמו ל-whitelist.

    match /families/{familyId} {
      allow read: if isFamilyMember(familyId);
      allow create, update, delete: if false;

      // --- מוצרים ---------------------------------------------------------
      match /products/{productId} {
        allow read: if isFamilyMember(familyId);

        allow create: if isFamilyMember(familyId)
          && isValidProduct()
          && request.resource.data.createdBy is string;

        allow update: if isFamilyMember(familyId)
          && isValidProduct()
          // אי אפשר לשכתב את יוצר הרשומה
          && request.resource.data.createdBy == resource.data.createdBy;

        allow delete: if isFamilyMember(familyId);
      }

      // --- העדפות פר-משתמש (אישור דיסקליימר) ------------------------------
      // כל משתמש קורא/כותב אך ורק את המסמך שלו עצמו.
      match /users/{userId} {
        allow read: if isFamilyMember(familyId) && request.auth.uid == userId;
        allow create, update: if isFamilyMember(familyId)
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['email', 'displayName', 'disclaimerAcceptedAt']);
        allow delete: if false;
      }
    }

    // כל השאר — חסום
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
